---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { 
  residentsYear5,
  residentsYear4, 
  residentsYear3, 
  alumniMembers, 
  allResidents,
  allMembers,
  academicYearCurrent,
  academicYearSource 
} from '../data/fellowship';

const { theme } = siteConfig;
---

<Layout title={`Resident, Fellow & Alumni | ${siteConfig.deptNameEn}`}>
  <div class="bg-slate-50 min-h-screen pb-20">
    
    <!-- Institutional Page Header Banner -->
    <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 text-white border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
        
        <!-- Breadcrumb & Badges -->
        <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-400 mb-4">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>&rsaquo;</span>
          <span class="text-white font-medium">Resident, Fellow & Alumni</span>
          <span class="text-slate-600">&bull;</span>
          <span class="bg-[#A6192E] text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
            ปีการศึกษา {academicYearCurrent}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white leading-tight">
          แพทย์ประจำบ้านและศิษย์เก่า
        </h1>
        <p class="text-base sm:text-lg text-rose-300 font-semibold mt-1">
          Resident, Clinical Fellow & Alumni Directory
        </p>

        <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
          ทำเนียบแพทย์ประจำบ้าน แพทย์ประจำบ้านต่อยอด และศิษย์เก่าสาขาวิชาศัลยศาสตร์ทรวงอก 
          ภาควิชาศัลยศาสตร์ คณะแพทยศาสตร์ จุฬาลงกรณ์มหาวิทยาลัย และโรงพยาบาลจุฬาลงกรณ์ สภากาชาดไทย
        </p>

        <!-- Academic Year Note Card -->
        <div class="mt-6 inline-flex flex-col sm:flex-row items-start sm:items-center gap-3 bg-white/5 border border-white/10 rounded-xl p-3.5 text-xs text-slate-300 backdrop-blur-sm">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
            <span class="font-bold text-white">การปรับปรุงข้อมูลปีการศึกษา {academicYearCurrent}:</span>
          </div>
          <span>
            แพทย์ประจำบ้านใหม่ & แพทย์ประจำบ้านต่อยอดปีการศึกษา {academicYearCurrent} และทำเนียบศิษย์เก่าศัลยศาสตร์ทรวงอกปีการศึกษา {academicYearCurrent}
          </span>
        </div>

      </div>
    </div>

    <!-- Filter Control Pills & Container -->
    <div class="max-w-6xl mx-auto px-4 pt-8">
      
      <!-- Interactive Filter Tabs -->
      <div class="flex flex-wrap items-center gap-2 pb-6 border-b border-slate-200">
        <button 
          type="button" 
          data-filter="all" 
          class="filter-btn active-filter px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition shadow-sm"
        >
          ทั้งหมด (All) ({allMembers.length})
        </button>
        <button 
          type="button" 
          data-filter="resident" 
          class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
        >
          แพทย์ประจำบ้าน (Residents) ({allResidents.length})
        </button>
        <button 
          type="button" 
          data-filter="alumni" 
          class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
        >
          ศิษย์เก่า (Alumni) ({alumniMembers.length})
        </button>
        <button 
          type="button" 
          data-filter="upcoming" 
          class="filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
        >
          แพทย์ประจำบ้านใหม่ & Fellow
        </button>
      </div>

      <!-- ============================================================ -->
      <!-- SECTION 1: RESIDENTS YEAR 5 (Chief Residents in 2569)         -->
      <!-- ============================================================ -->
      <div class="member-group py-8" data-category="resident">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
              <span>แพทย์ประจำบ้านปีที่ 5</span>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#A6192E] text-white shadow-sm">
                Chief Resident • ปีการศึกษา {academicYearCurrent}
              </span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">หัวหน้าแพทย์ประจำบ้านและแพทย์ประจำบ้านระดับหัวหน้า (Chief Residents)</p>
          </div>
          <span class="text-xs font-medium text-slate-500">จำนวน {residentsYear5.length} ท่าน</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {residentsYear5.map((member) => (
            <div class="member-card bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-[#A6192E]/40 transition overflow-hidden flex flex-col group">
              
              <!-- Photo Container -->
              <div class="relative aspect-[3/4] overflow-hidden bg-slate-100">
                {member.hasCustomPhoto ? (
                  <img 
                    src={member.image} 
                    alt={member.name}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500"
                    onerror="this.onerror=null; this.parentElement.classList.add('flex', 'items-center', 'justify-center'); this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                  />
                ) : null}

                <!-- Avatar Fallback -->
                <div class={`w-full h-full flex flex-col items-center justify-center bg-gradient-to-b from-slate-100 to-slate-200 text-slate-400 p-6 ${member.hasCustomPhoto ? 'hidden' : ''}`}>
                  <svg class="w-20 h-20 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                  <span class="text-[11px] font-medium text-slate-500 mt-2 text-center">ภาพอยู่ระหว่างอัปเดต</span>
                </div>

                <!-- Status Badge -->
                <div class="absolute top-3 right-3 z-10">
                  <span class="bg-[#A6192E] text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm">
                    ปีที่ 5 (Chief)
                  </span>
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
                <div>
                  <h3 class="font-bold text-slate-900 group-hover:text-[#A6192E] transition text-base tracking-tight leading-snug">
                    {member.name}
                  </h3>
                  <p class="text-xs font-semibold text-[#A6192E] mt-1">{member.roleTh}</p>
                  <p class="text-[11px] text-slate-500">{member.roleEn}</p>
                </div>

                <div class="pt-3 border-t border-slate-100 text-[10px] text-slate-400 whitespace-pre-line leading-relaxed">
                  <span>{member.transitionNote}</span>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- SECTION 2: RESIDENTS YEAR 4 (Current 2569)                    -->
      <!-- ============================================================ -->
      <div class="member-group py-8 border-t border-slate-200" data-category="resident">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
              <span>แพทย์ประจำบ้านปีที่ 4</span>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#A6192E]/10 text-[#A6192E] border border-[#A6192E]/20">
                Resident Year 4 • ปีการศึกษา {academicYearCurrent}
              </span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">แพทย์ประจำบ้านระดับสูง (Senior Residents)</p>
          </div>
          <span class="text-xs font-medium text-slate-500">จำนวน {residentsYear4.length} ท่าน</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {residentsYear4.map((member) => (
            <div class="member-card bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-[#A6192E]/40 transition overflow-hidden flex flex-col group">
              
              <!-- Photo Container -->
              <div class="relative aspect-[3/4] overflow-hidden bg-slate-100">
                {member.hasCustomPhoto ? (
                  <img 
                    src={member.image} 
                    alt={member.name}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500"
                    onerror="this.onerror=null; this.parentElement.classList.add('flex', 'items-center', 'justify-center'); this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                  />
                ) : null}

                <!-- Avatar Fallback -->
                <div class={`w-full h-full flex flex-col items-center justify-center bg-gradient-to-b from-slate-100 to-slate-200 text-slate-400 p-6 ${member.hasCustomPhoto ? 'hidden' : ''}`}>
                  <svg class="w-20 h-20 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                  <span class="text-[11px] font-medium text-slate-500 mt-2 text-center">ภาพอยู่ระหว่างอัปเดต</span>
                </div>

                <!-- Status Badge -->
                <div class="absolute top-3 right-3 z-10">
                  <span class="bg-[#A6192E]/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm">
                    ปีที่ 4
                  </span>
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
                <div>
                  <h3 class="font-bold text-slate-900 group-hover:text-[#A6192E] transition text-base tracking-tight leading-snug">
                    {member.name}
                  </h3>
                  <p class="text-xs font-semibold text-[#A6192E] mt-1">{member.roleTh}</p>
                  <p class="text-[11px] text-slate-500">{member.roleEn}</p>
                </div>

                <div class="pt-3 border-t border-slate-100 text-[10px] text-slate-400 whitespace-pre-line leading-relaxed">
                  <span>{member.transitionNote}</span>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- SECTION 3: RESIDENTS YEAR 3 (Current 2569)                    -->
      <!-- ============================================================ -->
      <div class="member-group py-8 border-t border-slate-200" data-category="resident">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
              <span>แพทย์ประจำบ้านปีที่ 3</span>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                Resident Year 3 • ปีการศึกษา {academicYearCurrent}
              </span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">แพทย์ประจำบ้านระดับกลาง (Intermediate Residents)</p>
          </div>
          <span class="text-xs font-medium text-slate-500">จำนวน {residentsYear3.length} ท่าน</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {residentsYear3.map((member) => (
            <div class="member-card bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-[#A6192E]/40 transition overflow-hidden flex flex-col group">
              
              <!-- Photo Container -->
              <div class="relative aspect-[3/4] overflow-hidden bg-slate-100">
                {member.hasCustomPhoto ? (
                  <img 
                    src={member.image} 
                    alt={member.name}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500"
                    onerror="this.onerror=null; this.parentElement.classList.add('flex', 'items-center', 'justify-center'); this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                  />
                ) : null}

                <!-- Avatar Fallback -->
                <div class={`w-full h-full flex flex-col items-center justify-center bg-gradient-to-b from-slate-100 to-slate-200 text-slate-400 p-6 ${member.hasCustomPhoto ? 'hidden' : ''}`}>
                  <svg class="w-20 h-20 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                  <span class="text-[11px] font-medium text-slate-500 mt-2 text-center">ภาพอยู่ระหว่างอัปเดต</span>
                </div>

                <!-- Status Badge -->
                <div class="absolute top-3 right-3 z-10">
                  <span class="bg-slate-800 text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm">
                    ปีที่ 3
                  </span>
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
                <div>
                  <h3 class="font-bold text-slate-900 group-hover:text-[#A6192E] transition text-base tracking-tight leading-snug">
                    {member.name}
                  </h3>
                  <p class="text-xs font-semibold text-[#A6192E] mt-1">{member.roleTh}</p>
                  <p class="text-[11px] text-slate-500">{member.roleEn}</p>
                </div>

                <div class="pt-3 border-t border-slate-100 text-[10px] text-slate-400 whitespace-pre-line leading-relaxed">
                  <span>{member.transitionNote}</span>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- SECTION 4: INCOMING & OPEN PROGRAM (Year 1 & 2 & Fellows)    -->
      <!-- ============================================================ -->
      <div class="member-group py-8 border-t border-slate-200" data-category="upcoming">
        <div class="mb-6">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
            <span>แพทย์ประจำบ้านใหม่ & แพทย์ประจำบ้านต่อยอด</span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
              รับสมัคร & รอประกาศผล
            </span>
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Incoming Residents (Year 1-2) & Clinical Fellowship Training Positions
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Placeholder Card: Resident Year 1 -->
          <div class="bg-white border-2 border-dashed border-slate-300 rounded-2xl p-6 text-center space-y-3 flex flex-col justify-between hover:border-[#A6192E]/50 transition">
            <div class="space-y-3">
              <div class="w-14 h-14 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
              </div>
              <span class="inline-block bg-slate-100 text-slate-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase">
                ปีการศึกษา {academicYearCurrent}
              </span>
              <h3 class="font-bold text-slate-800 text-base">แพทย์ประจำบ้านปีที่ 1 (New Incoming)</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                รอประกาศรายชื่อแพทย์ประจำบ้านใหม่ ประจำปีการศึกษา {academicYearCurrent} หลังเสร็จสิ้นกระบวนการคัดเลือก
              </p>
            </div>
            <div class="pt-4 border-t border-slate-100">
              <span class="text-[11px] font-semibold text-slate-400">อยู่ระหว่างเปิดรับสมัคร / รอประกาศผล</span>
            </div>
          </div>

          <!-- Placeholder Card: Resident Year 2 -->
          <div class="bg-white border-2 border-dashed border-slate-300 rounded-2xl p-6 text-center space-y-3 flex flex-col justify-between hover:border-[#A6192E]/50 transition">
            <div class="space-y-3">
              <div class="w-14 h-14 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </div>
              <span class="inline-block bg-slate-100 text-slate-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase">
                ปีการศึกษา 2568
              </span>
              <h3 class="font-bold text-slate-800 text-base">แพทย์ประจำบ้านปีที่ 2</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                รอประกาศรายชื่อแพทย์ประจำบ้าน ประจำปีการศึกษา 2568
              </p>
            </div>
            <div class="pt-4 border-t border-slate-100">
              <span class="text-[11px] font-semibold text-slate-400">อยู่ระหว่างปรับปรุงรายชื่อ</span>
            </div>
          </div>

          <!-- Placeholder Card: Clinical Fellow -->
          <div class="bg-white border-2 border-dashed border-slate-300 rounded-2xl p-6 text-center space-y-3 flex flex-col justify-between hover:border-[#A6192E]/50 transition">
            <div class="space-y-3">
              <div class="w-14 h-14 mx-auto rounded-full bg-rose-50 flex items-center justify-center text-[#A6192E]">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <span class="inline-block bg-rose-100 text-[#A6192E] text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase">
                Fellowship Program
              </span>
              <h3 class="font-bold text-slate-800 text-base">แพทย์ประจำบ้านต่อยอด (Fellow)</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                เปิดรับสมัครแพทย์ประจำบ้านต่อยอดอนุสาขาศัลยศาสตร์ทรวงอก / ผ่าตัดหัวใจและหลอดเลือด
              </p>
            </div>
            <div class="pt-4 border-t border-slate-100">
              <a 
                href="#contact" 
                class="text-xs font-semibold text-[#A6192E] hover:underline inline-flex items-center gap-1"
              >
                <span>สอบถามข้อมูลการสมัคร &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- SECTION 5: ALUMNI DIRECTORY                                  -->
      <!-- ============================================================ -->
      <div class="member-group py-8 border-t border-slate-200" data-category="alumni">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
              <span>ทำเนียบศิษย์เก่าศัลยศาสตร์ทรวงอก</span>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                Alumni Directory
              </span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">
              ศิษย์เก่าแพทย์ประจำบ้านและแพทย์ประจำบ้านต่อยอด สาขาวิชาศัลยศาสตร์ทรวงอก โรงพยาบาลจุฬาลงกรณ์
            </p>
          </div>
          <span class="text-xs font-medium text-slate-500">รวม {alumniMembers.length} ท่าน</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {alumniMembers.map((member) => (
            <div class="member-card bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-[#A6192E]/40 transition overflow-hidden flex flex-col group">
              
              <!-- Photo Container -->
              <div class="relative aspect-[3/4] overflow-hidden bg-slate-100">
                {member.hasCustomPhoto ? (
                  <img 
                    src={member.image} 
                    alt={member.name}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500"
                    onerror="this.onerror=null; this.parentElement.classList.add('flex', 'items-center', 'justify-center'); this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                  />
                ) : null}

                <!-- Avatar Fallback -->
                <div class={`w-full h-full flex flex-col items-center justify-center bg-gradient-to-b from-slate-100 to-slate-200 text-slate-400 p-6 ${member.hasCustomPhoto ? 'hidden' : ''}`}>
                  <svg class="w-20 h-20 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                  <span class="text-[11px] font-medium text-slate-500 mt-2 text-center">ภาพศิษย์เก่า</span>
                </div>

                <!-- Alumni Tag -->
                <div class="absolute top-3 right-3 z-10">
                  <span class="bg-slate-900/80 backdrop-blur-sm text-slate-200 text-[10px] font-medium px-2.5 py-1 rounded-full border border-white/10">
                    Alumni
                  </span>
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-5 flex-grow flex flex-col justify-between space-y-3">
                <div>
                  <h3 class="font-bold text-slate-900 group-hover:text-[#A6192E] transition text-base tracking-tight leading-snug">
                    {member.name}
                  </h3>
                  <p class="text-xs font-semibold text-slate-600 mt-1">{member.roleTh}</p>
                  <p class="text-[11px] text-slate-400">{member.roleEn}</p>
                </div>

                {member.transitionNote && (
                  <div class="pt-3 border-t border-slate-100 text-[10px] text-slate-400 whitespace-pre-line leading-relaxed">
                    <span>{member.transitionNote}</span>
                  </div>
                )}
              </div>

            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Institutional Footer CTA -->
    <div class="max-w-6xl mx-auto px-4 mt-12">
      <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 rounded-2xl p-6 md:p-8 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md border border-slate-700">
        <div class="space-y-1 text-center sm:text-left">
          <span class="text-xs font-semibold text-rose-300 uppercase tracking-wider">Cardiovascular & Thoracic Surgery Residency Program</span>
          <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight">
            สนใจสมัครแพทย์ประจำบ้านและแพทย์ประจำบ้านต่อยอด
          </h3>
          <p class="text-xs sm:text-sm text-slate-300">
            ภาควิชาศัลยศาสตร์ คณะแพทยศาสตร์ จุฬาลงกรณ์มหาวิทยาลัย
          </p>
        </div>
        <a 
          href="tel:022564000"
          style={`background-color: ${theme.primary};`}
          class="shrink-0 text-white text-xs sm:text-sm font-semibold px-5 py-2.5 rounded-xl hover:opacity-90 transition shadow-sm inline-flex items-center gap-2"
        >
          <span>ติดต่อสอบถามภาควิชา</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

  </div>

  <!-- Interactive Filter Script -->
  <script is:inline>
    (() => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const groups = document.querySelectorAll('.member-group');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Toggle button styles
          filterBtns.forEach(b => {
            b.classList.remove('active-filter', 'bg-[#A6192E]', 'text-white');
            b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
          });

          btn.classList.add('active-filter', 'bg-[#A6192E]', 'text-white');
          btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');

          // Toggle sections
          groups.forEach(group => {
            const category = group.getAttribute('data-category');
            if (filter === 'all' || category === filter) {
              group.style.display = '';
            } else {
              group.style.display = 'none';
            }
          });
        });
      });

      // Default active styling
      const activeBtn = document.querySelector('.active-filter');
      if (activeBtn) {
        activeBtn.classList.add('bg-[#A6192E]', 'text-white');
        activeBtn.classList.remove('bg-white', 'text-slate-700');
      }
    })();
  </script>
</Layout>

