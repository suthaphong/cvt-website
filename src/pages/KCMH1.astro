<div class="space-y-8 my-8">


  <!-- ============================================================ -->
  <!-- KCMH MEDICAL JOURNALS GRID (Clean & Responsive)              -->
  <!-- ============================================================ -->
  <div class="bg-white p-6 md:p-8 rounded-xl border border-slate-200 shadow-sm space-y-6">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
      <div>
        <h3 class="text-lg font-bold text-slate-900 tracking-tight">วารสาร ฬ.จุฬา</h3>
        <p class="text-xs text-slate-500">บทความวิชาการ นวัตกรรมทางการแพทย์ และรายงานผลการรักษา</p>
      </div>
      <a 
        href="https://kcmh.chulalongkornhospital.go.th/lorchula-journal/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-xs font-semibold text-[#A6192E] hover:underline inline-flex items-center gap-1"
      >
        ดูคลังวารสารทั้งหมด &rarr;
      </a>
    </div>

    <!-- 6 Columns on Desktop, 4 on Tablet, 2 on Mobile -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
      {journals.map((item) => (
        <a 
          href={item.link} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group block bg-slate-50 border border-slate-200 rounded-lg overflow-hidden hover:shadow-md hover:border-[#A6192E]/40 transition"
        >
          <!-- Ratio 3/4 Cover Book Presentation -->
          <div class="aspect-[3/4] overflow-hidden bg-slate-100 relative">
            <img 
              src={item.cover} 
              alt={item.title} 
              loading="lazy" 
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
          </div>
          <div class="p-2.5 text-center bg-white">
            <h4 class="text-xs font-semibold text-slate-800 group-hover:text-[#A6192E] transition truncate">
              {item.title}
            </h4>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- SLIM INSTITUTIONAL BANNER (Compact & Elegant)                 -->
  <!-- ============================================================ -->
  <div class="relative w-full rounded-xl overflow-hidden shadow-sm border border-slate-200 bg-slate-900 text-white">
    <img 
      src="/images/hero-bg.jpg" 
      alt="KCMH Facility" 
      class="absolute inset-0 w-full h-full object-cover opacity-25"
      onerror="this.style.display='none'"
    />
    <div class="relative z-10 px-6 py-5 md:py-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="bg-[#A6192E] text-white text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded">
            KCMH Portal
          </span>
          <span class="text-xs text-slate-300 font-medium">
            โรงพยาบาลจุฬาลงกรณ์ สภากาชาดไทย
          </span>
        </div>
        <h2 class="text-lg md:text-xl font-bold tracking-tight text-white">
          Excellence in Cardiovascular & Thoracic Care
        </h2>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <a 
          href="https://chulalongkornhospital.go.th" 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-[#A6192E] hover:bg-[#851324] text-white text-xs font-semibold px-4 py-2 rounded-lg shadow-sm transition inline-flex items-center gap-1.5"
        >
          <span>Official Portal</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <a 
          href="tel:022564000" 
          class="bg-white/10 hover:bg-white/20 border border-white/20 text-white text-xs font-semibold px-3 py-2 rounded-lg transition inline-flex items-center gap-1.5"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          02-256-4000
        </a>
      </div>
    </div>
  </div>


