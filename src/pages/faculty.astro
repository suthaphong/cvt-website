---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { facultyMembers } from '../data/department';

const { theme } = siteConfig;
---

<Layout title={`Faculty & Surgeons | ${siteConfig.deptNameEn}`}>
  <div class="bg-slate-50 min-h-screen pb-20">
    
    <!-- Institutional Page Header Banner -->
    <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 text-white border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
        
        <!-- Breadcrumb & Badges -->
        <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-400 mb-4">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>&rsaquo;</span>
          <span class="text-white font-medium">Faculty & Surgeons</span>
          <span class="text-slate-600">&bull;</span>
          <span class="bg-[#A6192E] text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
            คณาจารย์แพทย์
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white leading-tight">
          คณาจารย์สาขาวิชาศัลยศาสตร์ทรวงอก
        </h1>
        <p class="text-base sm:text-lg text-rose-300 font-semibold mt-1">
          Faculty, Cardiothoracic Surgeons & Academic Staff
        </p>

        <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
          คณาจารย์และศัลยแพทย์ผู้เชี่ยวชาญเฉพาะทางสาขาวิชาศัลยศาสตร์ทรวงอก ภาควิชาศัลยศาสตร์ 
          คณะแพทยศาสตร์ จุฬาลงกรณ์มหาวิทยาลัย และโรงพยาบาลจุฬาลงกรณ์ สภากาชาดไทย
        </p>

      </div>
    </div>

    <!-- Faculty Grid Container -->
    <div class="max-w-6xl mx-auto px-4 pt-10">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-8 pb-4 border-b border-slate-200">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
            ทำเนียบคณาจารย์ศัลยแพทย์ทรวงอก ({facultyMembers.length} ท่าน)
          </h2>
          <p class="text-xs text-slate-500 mt-1">อาจารย์แพทย์ประจำสาขาวิชาศัลยศาสตร์ทรวงอกและหัวใจ</p>
        </div>
        <a 
          href="/fellowship" 
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[#A6192E] hover:underline"
        >
          <span>ดูทำเนียบแพทย์ประจำบ้านและศิษย์เก่า &rarr;</span>
        </a>
      </div>

      <!-- 3-Column Responsive Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {facultyMembers.map((doc) => (
          <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-md hover:border-[#A6192E]/50 transition overflow-hidden flex flex-col justify-between group">
            
            <!-- Photo Block -->
            <div class="relative aspect-[3/4] overflow-hidden bg-slate-100">
              {doc.hasCustomPhoto ? (
                <img 
                  src={doc.image} 
                  alt={doc.nameTh}
                  loading="lazy"
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500"
                />
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-b from-slate-100 to-slate-200 text-slate-400 p-6">
                  <svg class="w-20 h-20 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                  <span class="text-xs font-semibold text-slate-600 mt-2">อาจารย์แพทย์</span>
                  <span class="text-[10px] text-slate-400 mt-0.5">ภาพอยู่ระหว่างอัปเดต</span>
                </div>
              )}

              {doc.isHead && (
                <div class="absolute top-3 left-3 z-10">
                  <span class="bg-[#A6192E] text-white text-[10px] font-bold px-3 py-1 rounded-full shadow-md uppercase tracking-wider flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                    หัวหน้าสาขาวิชาฯ
                  </span>
                </div>
              )}

              <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent p-5 text-white">
                {doc.academicRankTh && (
                  <span class="text-[11px] font-semibold text-rose-300 block mb-0.5">{doc.academicRankTh}</span>
                )}
                <h3 class="text-base sm:text-lg font-black leading-tight drop-shadow-sm">
                  {doc.nameTh}
                </h3>
                <p class="text-[11px] text-slate-300 font-medium mt-0.5">{doc.nameEn}</p>
              </div>
            </div>

            <!-- Content Body -->
            <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <p class="text-xs font-bold text-[#A6192E] leading-snug">
                  {doc.roleTh}
                </p>
                <p class="text-[11px] text-slate-500">{doc.roleEn}</p>
                
                <!-- Subspecialty Badges -->
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {doc.subspecialties.map((sub) => (
                    <span class="text-[10px] font-medium bg-slate-100 text-slate-700 px-2 py-0.5 rounded-md">
                      {sub}
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>โทร: {doc.officePhone}</span>
                </span>
                <span class="text-rose-700 font-semibold">รพ.จุฬาลงกรณ์</span>
              </div>

            </div>

          </div>
        ))}
      </div>

      <!-- Bottom Banner Linking to Fellowship -->
      <div class="mt-12 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 rounded-3xl p-6 sm:p-8 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md border border-slate-700">
        <div class="space-y-1 text-center sm:text-left">
          <span class="text-xs font-semibold text-rose-300 uppercase tracking-wider">Education & Training</span>
          <h3 class="text-xl font-bold text-white tracking-tight">
            ทำเนียบแพทย์ประจำบ้าน แพทย์ประจำบ้านต่อยอด และศิษย์เก่า
          </h3>
          <p class="text-xs sm:text-sm text-slate-300">
            ดูรายชื่อแพทย์ประจำบ้านทุกชั้นปี และศิษย์เก่าแพทย์ประจำบ้านศัลยศาสตร์ทรวงอก รพ.จุฬาลงกรณ์
          </p>
        </div>
        <a 
          href="/fellowship"
          style={`background-color: ${theme.primary};`}
          class="shrink-0 text-white text-xs sm:text-sm font-semibold px-5 py-3 rounded-xl hover:opacity-90 transition shadow-sm inline-flex items-center gap-2"
        >
          <span>ดูทำเนียบแพทย์ประจำบ้าน &rarr;</span>
        </a>
      </div>

    </div>

  </div>
</Layout>

