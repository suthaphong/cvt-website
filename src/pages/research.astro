---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { researchHighlights } from '../data/department';

const { theme } = siteConfig;
---

<Layout title={`Research & International Recognition | ${siteConfig.deptNameEn}`}>
  <div class="bg-slate-50 min-h-screen pb-20">
    
    <!-- Institutional Page Header Banner -->
    <div class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 text-white border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-4 py-12 md:py-16">
        
        <!-- Breadcrumb & Badges -->
        <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-400 mb-4">
          <a href="/" class="hover:text-white transition">Home</a>
          <span>&rsaquo;</span>
          <span class="text-white font-medium">Research & Innovation</span>
          <span class="text-slate-600">&bull;</span>
          <span class="bg-[#A6192E] text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
            ผลงานวิจัยระดับสากล
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white leading-tight">
          งานวิจัยและผลงานระดับนานาชาติ
        </h1>
        <p class="text-base sm:text-lg text-rose-300 font-semibold mt-1">
          Research, Global Recognition & Academic Presentations
        </p>

        <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
          ศัลยแพทย์และแพทย์ประจำบ้านสาขาวิชาศัลยศาสตร์ทรวงอก โรงพยาบาลจุฬาลงกรณ์ สภากาชาดไทย 
          สร้างสรรค์งานวิจัยที่มีคุณภาพ และได้รับรางวัลชนะการประกวดพร้อมทั้งนำเสนอผลงานบนเวทีวิชาการระดับโลกอย่างต่อเนื่อง
        </p>

      </div>
    </div>

    <!-- Main Content Container -->
    <div class="max-w-6xl mx-auto px-4 pt-10 space-y-12">
      
      <!-- Highlights Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {researchHighlights.map((res) => (
          <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-md transition overflow-hidden flex flex-col justify-between group">
            <div class="p-6 sm:p-8 space-y-4">
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span class="bg-rose-50 text-[#A6192E] font-bold px-2.5 py-1 rounded-full text-[10px]">
                  {res.date}
                </span>
                <span class="font-medium text-slate-400">International Congress</span>
              </div>

              <h2 class="text-xl font-black text-slate-900 group-hover:text-[#A6192E] transition leading-snug">
                {res.titleTh}
              </h2>
              <p class="text-xs text-rose-700 font-semibold">{res.titleEn}</p>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{res.description}</p>
              
              <div class="text-[11px] text-slate-500 bg-slate-50 p-3 rounded-xl border border-slate-100 flex items-center gap-2">
                <svg class="w-4 h-4 text-[#A6192E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{res.venue}</span>
              </div>
            </div>

            <!-- Two Photos Showcase -->
            <div class="grid grid-cols-2 gap-3 p-6 sm:p-8 pt-0">
              {res.images.map((img) => (
                <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-slate-100 border border-slate-200">
                  <img 
                    src={img} 
                    alt={res.titleTh} 
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Academic Links Card -->
      <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 rounded-3xl p-6 sm:p-8 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md border border-slate-700">
        <div class="space-y-1 text-center sm:text-left">
          <span class="text-xs font-semibold text-rose-300 uppercase tracking-wider">Publications & Knowledge</span>
          <h3 class="text-xl font-bold text-white tracking-tight">
            คลังวารสารความรู้ทางการแพทย์ ฬ.จุฬา (KCMH Journal)
          </h3>
          <p class="text-xs sm:text-sm text-slate-300">
            รวมบทความวิชาการ นวัตกรรมการแพทย์ และความรู้ด้านการดูแลสุขภาพจากโรงพยาบาลจุฬาลงกรณ์
          </p>
        </div>
        <a 
          href="/KCMH1"
          style={`background-color: ${theme.primary};`}
          class="shrink-0 text-white text-xs sm:text-sm font-semibold px-5 py-3 rounded-xl hover:opacity-90 transition shadow-sm inline-flex items-center gap-2"
        >
          <span>เปิดดูวารสารทั้งหมด &rarr;</span>
        </a>
      </div>

    </div>

  </div>
</Layout>

