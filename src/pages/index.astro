---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CVT Surgery | Home">
  <!-- Hero Section -->
  <section class="py-12 text-center md:text-left md:flex items-center justify-between gap-8">
    <div class="max-w-2xl space-y-4">
      <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">
        Excellence in Cardiovascular & Thoracic Care
      </h1>
      <p class="text-lg text-slate-600">
        Providing advanced surgical interventions, fellowship training, and clinical research in adult cardiac, general thoracic, and aortic surgery.
      </p>
      <div class="pt-2 flex gap-4 justify-center md:justify-start">
        <a href="#services" class="bg-blue-900 text-white px-5 py-2.5 rounded-lg font-medium shadow hover:bg-blue-800 transition">
          Clinical Services
        </a>
        <a href="#contact" class="bg-white border border-slate-300 text-slate-700 px-5 py-2.5 rounded-lg font-medium hover:bg-slate-100 transition">
          Refer a Patient
        </a>
      </div>
    </div>
  </section>

  <!-- Clinical Focus Cards -->
  <section id="services" class="py-12 border-t border-slate-200">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">Clinical Programs</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-lg text-blue-900 mb-2">Adult Cardiac</h3>
        <p class="text-sm text-slate-600">Coronary revascularization, minimally invasive valve repair, and complex structural interventions.</p>
      </div>
      <div class="p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-lg text-blue-900 mb-2">Thoracic & Oncology</h3>
        <p class="text-sm text-slate-600">Video-assisted thoracoscopic surgery (VATS), lung resections, and mediastinal tumor resections.</p>
      </div>
      <div class="p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-lg text-blue-900 mb-2">Aortic Center</h3>
        <p class="text-sm text-slate-600">Comprehensive surgical and endovascular management of ascending, arch, and thoracoabdominal aortic aneurysms.</p>
      </div>
    </div>
  </section>
</Layout>