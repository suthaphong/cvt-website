---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import KCMH1 from '../pages/KCMH1.astro';
import Medumore from '../pages/Medumore.astro';

const { hero, programs, theme } = siteConfig;
---

<Layout title={`${siteConfig.deptNameEn} | ${siteConfig.hospitalEn}`}>
  <!-- Hero Section -->
  <section class="py-12 border-b border-slate-200">
    <div class="max-w-3xl space-y-4">
      <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {hero.title}
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        {hero.description}
      </p>
      <div class="flex items-center gap-3 pt-2">
        <a 
          href={hero.primaryBtn.href}
          style={`background-color: ${theme.primary};`}
          class="text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:opacity-90 transition shadow-sm"
        >
          {hero.primaryBtn.label}
        </a>
        <a 
          href={hero.secondaryBtn.href}
          class="bg-white border border-slate-300 text-slate-700 px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-slate-50 transition"
        >
          {hero.secondaryBtn.label}
        </a>
      </div>
    </div>
  </section>

 <!-- Clinical Programs Section -->
  <section id="services" class="py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Clinical Programs & Subspecialties</h2>
        <p class="text-sm text-slate-500 mt-1">Tertiary cardiovascular and thoracic surgical services</p>
      </div>
    </div>

    <!-- 4-Column Responsive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {programs.map((item) => (
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
          <div>
            <h3 
              style={`color: ${theme.primary};`}
              class="text-base font-bold mb-3 tracking-tight leading-snug"
            >
              {item.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center text-xs font-semibold" style={`color: ${theme.primary};`}>
            <span>Learn more &rarr;</span>
          </div>
        </div>
      ))}
    </div>
  </section>

    <!-- MDCU MEDUMORE Segment -->
  <section id="medumore" class="py-12 border-b border-slate-200"></section>
  <Medumore />
  <section></section>

  <section id="kcmh-section" class="py-12 border-b border-slate-200">
    <KCMH1 />
  </section>
</Layout>