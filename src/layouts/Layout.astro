---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { Image } from 'astro:assets';
import logoImg from '../assets/Logo.png';

const { title = siteConfig?.deptNameEn || "CVT Surgery" } = Astro.props;
const theme = siteConfig?.theme || { primary: '#A6192E', accent: '#DE5C8E', dark: '#1E293B' };
const hotline = siteConfig?.hotline || { label: 'Emergency', phone: '', link: '#' };
const navLinks = siteConfig?.navLinks || [];
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen antialiased">
    
    <!-- Top Identity Ribbon -->
    <div style={`background-color: ${theme.primary};`} class="text-white text-xs py-2 px-4 shadow-sm">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <span class="font-medium tracking-wide">
          {siteConfig?.deptNameEn} | {siteConfig?.hospitalEn}
        </span>
        <div class="flex items-center gap-4">
          <a href={hotline.link} class="hover:underline flex items-center gap-1.5 font-semibold text-white">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            {hotline.label}: {hotline.phone}
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
        
        <!-- Brand & Logo Block -->
        <a href="/" class="flex items-center gap-3">
        <Image src={logoImg} alt="CVT Chula Logo" class="h-12 w-auto object-contain" loading="eager" />
          <div class="flex flex-col">
            <span class="font-black text-xl text-slate-900 tracking-tight leading-tight">
              CVT <span style={`color: ${theme.primary};`}>CHULA</span>
            </span>
            <span class="text-xs text-slate-500 font-medium">
              {siteConfig?.subTitle || siteConfig?.hospitalEn}
            </span>
          </div>
        </a>
        
      <!-- Dynamic Menu Tabs -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-700">
          {navLinks.map((link) => (
            <a 
              href={link.href} 
              class="hover:opacity-80 transition py-1 border-b-2 border-transparent hover:border-current"
            >
              {link.label}
            </a>
          ))}
          <a 
            href="#contact" 
            style={`background-color: ${theme.primary};`}
            class="text-white px-4 py-2 rounded-lg text-sm font-medium transition hover:opacity-90 shadow-sm"
          >
            Contact
          </a>
        </nav>

        
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow w-full">
      <slot />
    </main>

    <!-- Footer -->
    <footer style={`background-color: ${theme.dark};`} class="text-slate-400 py-10 text-xs border-t border-slate-800">
      <div class="max-w-6xl mx-auto px-4 text-center space-y-2">
        <p class="text-white font-medium">{siteConfig?.deptNameTh} {siteConfig?.hospitalTh}</p>
        <p>{siteConfig?.deptNameEn} &bull; {siteConfig?.hospitalEn}</p>
        <p class="pt-4 text-slate-500">&copy; {new Date().getFullYear()} All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

