---
import '../styles/global.css';

const { title = "Division of Cardiovascular & Thoracic Surgery" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">
    <!-- Header / Nav -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="font-bold text-lg text-blue-900 tracking-tight">
          CVT Surgery
        </a>
        <nav class="flex gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-blue-900 transition">Home</a>
          <a href="#services" class="hover:text-blue-900 transition">Services</a>
          <a href="#team" class="hover:text-blue-900 transition">Faculty</a>
          <a href="#contact" class="hover:text-blue-900 transition">Contact</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Injection -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 text-sm border-t border-slate-800">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <p>&copy; {new Date().getFullYear()} Division of Cardiovascular and Thoracic Surgery. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>